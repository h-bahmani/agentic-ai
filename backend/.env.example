# Copy values into the process environment, or use scripts/start.ps1 -EnvFile.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
MCP_URL=http://127.0.0.1:8560/mcp
MCP_ALLOWLIST=all_readonly
LLM_CONTEXT=4096
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
RUN_TIMEOUT=240
MAX_TOOL_STEPS=6
# Deterministic reports: max 200 rows per page; no final answer on truncation.
REPORT_MAX_PAGES=30
# Optional development shared secret. Not production identity/RBAC.
AGENT_API_TOKEN=
# Optional path to existing WhisperMCP folder; default is the sibling WhisperMCP.
# WHISPER_MCP_DIR=
# Local-only durable prototype database. Separate from company PostgreSQL.
# LOCAL_WORKSPACE_DB=
# Future GPU/Outlook/Telegram slots are disabled contracts; no credentials required yet.
